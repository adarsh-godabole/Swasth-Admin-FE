# Deployed backend (default). Local: http://localhost:3000/api/v1
VITE_API_BASE_URL=https://swasth-be.onrender.com/api/v1
VITE_GYM_CODE=swasth-koramangala

# ---- Telemetry (Grafana Faro) ----
# Optional. Blank means no monitoring is initialised at all — nothing is sent
# and nothing can break because of a missing key.
#
# Grafana Cloud -> Frontend Observability -> create an app -> it gives you a
# collector URL that already contains the app key.
VITE_FARO_URL=
# Shown against every error so you can tell which build a crash came from.
VITE_APP_VERSION=dev
